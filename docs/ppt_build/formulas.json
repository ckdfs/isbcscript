{
  "formulas": [
    {"id": "F01", "mode": "display", "latex": "I_{out} = \\frac{\\eta P_{in} L}{2}\\bigl[1+\\cos(\\phi_{total})\\bigr]"},
    {"id": "F02", "mode": "display", "latex": "\\phi_{total} = m_{pilot}\\sin(\\omega_{pilot} t) + \\phi_{switching}(t) + \\phi_{DC}"},
    {"id": "F03", "mode": "display", "latex": "m_{pilot} = \\frac{\\pi V_{pilot,peak}}{V_\\pi}"},
    {"id": "F04", "mode": "display", "latex": "e^{jm\\sin\\theta} = \\sum_{n=-\\infty}^{\\infty} J_n(m)\\, e^{jn\\theta}"},
    {"id": "F05", "mode": "display", "latex": "\\cos\\!\\bigl(m\\sin\\omega t + \\phi_{DC}\\bigr) = J_0(m)\\cos\\phi_{DC} - 2J_1(m)\\sin\\phi_{DC}\\cdot\\sin\\omega t - 2J_2(m)\\cos\\phi_{DC}\\cdot\\cos 2\\omega t + \\cdots"},
    {"id": "F06", "mode": "display", "latex": "S_1 \\propto \\kappa\\,J_1(m)\\,\\sin(\\phi_{DC}+\\phi_0),\\qquad S_2 \\propto \\kappa\\,J_2(m)\\,\\cos(\\phi_{DC}+\\phi_0)"},
    {"id": "F07", "mode": "display", "latex": "\\phi_0 = \\arctan\\!\\Bigl(\\frac{1-A}{A}\\Bigr),\\qquad \\kappa = \\sqrt{A^2 + (1-A)^2}"},
    {"id": "F08", "mode": "display", "latex": "r = \\sqrt{\\frac{P_1}{P_2}} = \\frac{J_1(m)}{J_2(m)}\\,\\bigl|\\tan(\\phi_{DC}+\\phi_0)\\bigr|"},
    {"id": "F09", "mode": "display", "latex": "r \\approx \\frac{4}{m_{pilot}} = \\frac{4V_\\pi}{\\pi V_{pilot,peak}} \\approx 17 \\quad (m_{pilot}\\ll 1)"},
    {"id": "F10", "mode": "display", "latex": "r(V_{DC,eff}) = A\\,\\Bigl|\\tan\\!\\Bigl(\\frac{\\pi}{4} - \\frac{\\pi(v-V_0)}{V_\\pi^{fit}}\\Bigr)\\Bigr|"},
    {"id": "F11", "mode": "display", "latex": "S_1 \\propto \\sqrt{2}\\,J_1(m)\\,|\\sin\\phi_{DC}|,\\qquad S_2 \\propto 2\\,J_2(m)\\,|\\cos\\phi_{DC}|"},
    {"id": "F12", "mode": "display", "latex": "V_{offset} \\;\\leftarrow\\; V_{offset} - K_I\\,(r - r_{target})"},
    {"id": "F13", "mode": "display", "latex": "\\text{probe} = \\max\\!\\bigl(0.02,\\;\\min(0.10,\\;\\Delta_{dB}/50)\\bigr),\\qquad \\text{step} = c\\cdot\\Delta_{dB}"},
    {"id": "F14", "mode": "display", "latex": "\\kappa_{\\min}\\bigl|_{A=0.5} = \\tfrac{1}{\\sqrt{2}} \\;\\Longrightarrow\\; -3\\,\\text{dB}\\ \\text{power loss}"},
    {"id": "F15", "mode": "display", "latex": "r_{target}^{theory}(A) = \\frac{J_1(m)}{J_2(m)}\\,\\tan\\phi_0 = \\frac{J_1(m)}{J_2(m)}\\cdot\\frac{1-A}{A}"},
    {"id": "F16", "mode": "display", "latex": "\\begin{aligned} A=0.3 &: \\phi_0=66.8^\\circ,\\ r_{target}\\approx 39.7\\ (31.97\\,\\text{dB}) \\\\ A=0.5 &: \\phi_0=45.0^\\circ,\\ r_{target}\\approx 17.0\\ (24.61\\,\\text{dB}) \\\\ A=0.7 &: \\phi_0=23.2^\\circ,\\ r_{target}\\approx 7.29\\ (17.25\\,\\text{dB}) \\end{aligned}"},

    {"id": "F07a", "mode": "display", "latex": "\\phi_0 = \\arctan\\!\\Bigl(\\frac{1-A}{A}\\Bigr)"},
    {"id": "F07b", "mode": "display", "latex": "\\kappa = \\sqrt{A^2 + (1-A)^2}"},
    {"id": "F09a", "mode": "display", "latex": "\\frac{J_1(m)}{J_2(m)} \\approx \\frac{4}{m_{pilot}} = \\frac{4 V_\\pi}{\\pi\\,V_{pilot,peak}} \\approx 17"},
    {"id": "F11a", "mode": "display", "latex": "|S_1| = \\sqrt{2}\\,J_1(m_{pilot})\\,|\\sin\\phi_{DC}|"},
    {"id": "F11b", "mode": "display", "latex": "|S_2| = 2\\,J_2(m_{pilot})\\,|\\cos\\phi_{DC}|"},
    {"id": "F13a", "mode": "display", "latex": "\\text{probe} = \\max\\!\\bigl(0.02,\\;\\min(0.10,\\;\\Delta_{dB}/50)\\bigr)\\ \\text{V}"},
    {"id": "F13b", "mode": "display", "latex": "\\text{step} = c\\cdot\\Delta_{dB}\\quad(c = 0.001\\ \\text{V/dB for}\\ S_1,\\ 0.003\\ \\text{V/dB for}\\ S_2)"},
    {"id": "F17",  "mode": "display", "latex": "r_{target} = A_{fit} = \\frac{J_1(m)}{J_2(m)}\\,\\tan(\\phi_0)"},
    {"id": "F18",  "mode": "display", "latex": "m_{pilot} = \\frac{\\pi \\times 0.4}{5.4} \\approx 0.235 \\;\\Longrightarrow\\; \\frac{J_1}{J_2} \\approx 17\\ (24.6\\,\\text{dB})"},
    {"id": "F19",  "mode": "display", "latex": "V_{offset}^{ARB} = \\frac{V_\\pi}{2} + 0.8\\ \\text{Vpp},\\quad V_{offset}^{init} = \\frac{V_\\pi}{4}\\ (\\text{max\\_quad})\\;/\\;\\frac{V_\\pi}{2}\\ (\\text{quad\\_pm}/\\text{max\\_min})"},
    {"id": "F20",  "mode": "display", "latex": "S_1 \\propto J_1\\sin\\phi_{DC}\\cdot[-A\\cos\\omega t + (1-A)\\sin\\omega t],\\quad S_2 \\propto -2J_2\\cos\\phi_{DC}\\cdot\\cos 2\\omega t"},
    {"id": "F21",  "mode": "display", "latex": "\\phi_{DC} = n\\pi\\ (\\text{MAX/MIN}),\\quad \\phi_{DC} = \\tfrac{\\pi}{2}+n\\pi\\ (\\text{QUAD})"},
    {"id": "F22",  "mode": "display", "latex": "P_1 = 10^{S_1/10},\\quad P_2 = 10^{S_2/10},\\quad r = \\sqrt{P_1/P_2}"},

    {"id": "B1a", "mode": "display", "latex": "\\cos(m\\sin\\theta) = J_0(m) + 2J_2(m)\\cos 2\\theta + 2J_4(m)\\cos 4\\theta + \\cdots"},
    {"id": "B1b", "mode": "display", "latex": "\\sin(m\\sin\\theta) = 2J_1(m)\\sin\\theta + 2J_3(m)\\sin 3\\theta + 2J_5(m)\\sin 5\\theta + \\cdots"},
    {"id": "B1c", "mode": "display", "latex": "\\begin{aligned} J_0(0.235) &\\approx 0.9863, & J_1(0.235) &\\approx 0.1169, & J_2(0.235) &\\approx 6.89\\!\\times\\!10^{-3}\\\\ J_3(0.235) &\\approx 2.7\\!\\times\\!10^{-4}, & J_4(0.235) &\\approx 8.0\\!\\times\\!10^{-6} \\end{aligned}"},
    {"id": "B1d", "mode": "display", "latex": "J_n(m) \\approx \\frac{(m/2)^n}{n!}\\;(m\\ll 1)\\;\\Longrightarrow\\; r_{target} \\approx \\frac{4\\,V_\\pi}{\\pi\\,V_{pilot,peak}}"},

    {"id": "B2a", "mode": "display", "latex": "\\text{State A}\\;(\\phi_A=\\pi,\\,\\sin\\text{ pilot}):\\; P_A \\propto 1 - J_0\\cos\\phi_{DC} - 2J_2\\cos\\phi_{DC}\\cos 2\\omega t + 2J_1\\sin\\phi_{DC}\\sin\\omega t + \\cdots"},
    {"id": "B2b", "mode": "display", "latex": "\\text{State B}\\;(\\phi_B=0,\\,\\cos\\text{ pilot}):\\; P_B \\propto 1 + J_0\\cos\\phi_{DC} - 2J_2\\cos\\phi_{DC}\\cos 2\\omega t - 2J_1\\sin\\phi_{DC}\\cos\\omega t + \\cdots"},
    {"id": "B2c", "mode": "display", "latex": "S_1 = \\sqrt{2}\\,J_1(m)\\,|\\sin\\phi_{DC}|\\quad(\\sqrt{2}\\text{ from }\\sin\\omega t - \\cos\\omega t)"},
    {"id": "B2d", "mode": "display", "latex": "S_2 = 2\\,J_2(m)\\,|\\cos\\phi_{DC}|\\quad(\\text{two states add with same sign, A-independent})"},
    {"id": "B2e", "mode": "display", "latex": "r = \\frac{1}{\\sqrt{2}}\\,\\frac{J_1(m)}{J_2(m)}\\,|\\tan\\phi_{DC}|\\;\\xrightarrow{\\phi_{DC}\\to\\pi/2}\\;\\infty\\;\\Longrightarrow\\;\\text{use }S_2\\to\\min"},

    {"id": "B3a", "mode": "display", "latex": "\\frac{r_{meas}}{r_{theory}} \\approx \\frac{H(20\\,\\text{kHz})}{H(40\\,\\text{kHz})} \\approx 1.0\\sim 1.2\\;(+0\\sim +2\\,\\text{dB})"},

    {"id": "F23", "mode": "display", "latex": "S_2^{\\,\\mathrm{sin/sin}} \\propto 2J_2\\bigl[A\\cos\\phi_A + (1-A)\\cos\\phi_B\\bigr]\\cos 2\\omega t \\;\\xrightarrow{\\;\\phi_B=\\phi_A+\\pi\\;}\\; 2J_2\\,(2A-1)\\cos\\phi_{DC}\\cos 2\\omega t \\;\\xrightarrow{\\;A=1/2\\;}\\; 0"},
    {"id": "F24", "mode": "display", "latex": "S_2^{\\,\\mathrm{cos/sin}} \\propto 2J_2\\bigl[A + (1-A)\\bigr]\\,|\\cos\\phi_{DC}|\\cos 2\\omega t = 2J_2\\,|\\cos\\phi_{DC}|\\cos 2\\omega t \\quad(A\\text{-independent})"},
    {"id": "F25", "mode": "display", "latex": "\\text{state A}:\\;\\cos(m\\sin\\omega t + \\phi_A),\\qquad \\text{state B}:\\;\\cos(m\\cos\\omega t + \\phi_B)"},
    {"id": "F26", "mode": "display", "latex": "S(t) = A\\,S_A(t) + (1-A)\\,S_B(t)\\quad(\\text{50\\% PWM weighting})"},

